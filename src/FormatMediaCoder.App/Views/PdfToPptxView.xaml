<UserControl x:Class="FormatMediaCoder.App.Views.PdfToPptxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgApp}"
             AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="PDF → PowerPoint" Foreground="{StaticResource Text1}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="El cliente manda el guion en PDF y el bolo se dispara desde PowerPoint. Cada página se convierte en una diapositiva a página completa, con su proporción intacta y sin depender de las fuentes del equipo: se ve exactamente lo que aprobó el cliente."
                       Foreground="{StaticResource Text2}" FontSize="13" Margin="0,4,0,18" TextWrapping="Wrap" />

            <!-- ── PDFs de entrada ── -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PASO 1 · LOS PDFs" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="{Binding FilesSummary}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" Foreground="{StaticResource Text1}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="▲" Style="{StaticResource GhostButton}" Padding="8,2" Margin="6,0,0,0"
                                                    ToolTip="Subir"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="▼" Style="{StaticResource GhostButton}" Padding="8,2" Margin="4,0,0,0"
                                                    ToolTip="Bajar"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource GhostButton}" Padding="8,2" Margin="4,0,0,0"
                                                    ToolTip="Quitar de la lista"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="📄  Añadir PDFs" Style="{StaticResource GhostButton}" Command="{Binding AddFilesCommand}" />
                        <Button Content="🗑  Vaciar" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
                    </StackPanel>
                    <TextBlock Text="También puedes arrastrarlos y soltarlos aquí. Varios PDFs se unen en una sola presentación, en el orden de la lista."
                               Foreground="{StaticResource Text3}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── Cómo se monta ── -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PASO 2 · CÓMO SE MONTA" Style="{StaticResource StepTitle}" />

                    <TextBlock Text="TAMAÑO DE DIAPOSITIVA" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                    <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" DisplayMemberPath="Label" />
                    <TextBlock Text="Si la página no cuadra con la diapositiva, se centra entera con bandas: nunca se recorta ni se deforma."
                               Foreground="{StaticResource Text3}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,7,0">
                            <TextBlock Text="RESOLUCIÓN" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <TextBlock Text="IMAGEN" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="COLOR DE LAS BANDAS" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding SelectedBackground}" DisplayMemberPath="Label" />
                </StackPanel>
            </Border>

            <!-- ── Salida ── -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="PASO 3 · GUARDAR" Style="{StaticResource StepTitle}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OutputFile, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="💾  Guardar como…" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding SaveAsCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="▶  Convertir a PowerPoint" Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}" />
                        <Button Content="✕  Cancelar" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding CancelCommand}" />
                    </StackPanel>

                    <ProgressBar Height="6" Margin="0,14,0,6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Border}" BorderThickness="0" />
                    <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
