<UserControl x:Class="FormatMediaCoder.App.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgApp}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Convertir Vídeo" Foreground="{StaticResource Text1}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Cambia el contenedor o los codecs de un archivo. Incluye HAP con su variante (conserva el alfa)."
                       Foreground="{StaticResource Text2}" FontSize="13" Margin="0,4,0,18" TextWrapping="Wrap" />

            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <!-- Entrada -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InputFile}" IsReadOnly="True" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="📁  Elegir archivo" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding PickCommand}" />
                    </Grid>

                    <!-- Formato -->
                    <TextBlock Text="FORMATO DE SALIDA" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Label" />

                    <!-- Variante HAP -->
                    <StackPanel Visibility="{Binding ShowHapVariant, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="VARIANTE HAP" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <ComboBox ItemsSource="{Binding HapVariants}" SelectedItem="{Binding SelectedHapVariant}" />
                        <TextBlock Text="hap_alpha conserva transparencia · hap_q máxima calidad sin alfa · hap básico"
                                   Foreground="{StaticResource Text3}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Bitrates -->
                    <StackPanel Visibility="{Binding ShowBitrates, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                <TextBlock Text="BITRATE VÍDEO" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding VideoBitrates}" SelectedItem="{Binding VideoBitrate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="BITRATE AUDIO" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding AudioBitrate}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Normalizar -->
                    <CheckBox Content="Normalizar audio (EBU R128 / -23 LUFS)" IsChecked="{Binding NormalizeAudio}"
                              Foreground="{StaticResource Text2}" Margin="0,16,0,0" />

                    <!-- Acción -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="▶  Convertir" Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}" />
                        <Button Content="✕  Cancelar" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding CancelCommand}" />
                    </StackPanel>

                    <ProgressBar Height="6" Margin="0,14,0,6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Border}" BorderThickness="0" />
                    <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Text2}" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
