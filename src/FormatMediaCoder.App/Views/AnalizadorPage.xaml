<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FormatMediaCoder.App.Views.AnalizadorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,8,28,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="0">
            <TextBlock Text="Analizador" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,2" />
            <TextBlock Text="Suelta un archivo y ve qué es: codec, resolución, fps, canal alfa, audio."
                       Foreground="{StaticResource FmcText2}" FontSize="13" Margin="0,0,0,18" TextWrapping="Wrap" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InputFile}" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Elegir archivo" Click="PickFile_Click" />
                    </Grid>

                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource FmcText2}" FontSize="12" />

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="1" Margin="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource FmcField}" Padding="10,7">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource FmcText2}" FontSize="12" />
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource FmcField}" Padding="10,7">
                                        <TextBlock Text="{Binding Value}" FontSize="12" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
