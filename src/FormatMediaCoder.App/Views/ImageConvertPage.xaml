<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FormatMediaCoder.App.Views.ImageConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,8,28,28">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Convertir Imágenes" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,2" />
            <TextBlock Text="JPG, PNG, WEBP o ICO. Los iconos salen a 256×256."
                       Foreground="{StaticResource FmcText2}" FontSize="13" Margin="0,0,0,18" TextWrapping="Wrap" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InputFile}" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Elegir imagen" Click="PickFile_Click" />
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="FORMATO" Foreground="{StaticResource FmcText3}" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Convertir" Style="{StaticResource AccentButton}" Command="{Binding ConvertCommand}" />
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource FmcText2}" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
