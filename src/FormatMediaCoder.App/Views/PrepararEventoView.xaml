<UserControl x:Class="FormatMediaCoder.App.Views.PrepararEventoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgApp}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <!-- Cabecera -->
            <TextBlock Text="Preparar Evento" Foreground="{StaticResource Text1}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Recibe el material del cliente en el desorden en que llega y déjalo listo para el servidor del bolo."
                       Foreground="{StaticResource Text2}" FontSize="13" Margin="0,4,0,20" TextWrapping="Wrap" />

            <!-- ── PASO 1 — ENTRADA ── -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PASO 1 · ENTRADA" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="Suelta una carpeta entera (acepta subcarpetas). Es como llega el material del cliente."
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="📁  Elegir carpeta" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="PickFolder_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── PASO 2 — DESTINO ── -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PASO 2 · DESTINO" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="Elige el perfil del sistema de reproducción. Es la decisión importante: el codec es una consecuencia."
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name" FontSize="14" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ProfileWarning}" Foreground="{StaticResource Accent}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ProfileWarning, Converter={StaticResource EmptyToCollapsed}}" />
                    <Button Content="🔍  Analizar material" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Command="{Binding ScanCommand}" />
                </StackPanel>
            </Border>

            <!-- ── PASO 3 — DIAGNÓSTICO ── -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PASO 3 · DIAGNÓSTICO" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Text1}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding Summary, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Text="En cinco segundos ves lo que hoy tardas media hora en comprobar a mano."
                               Foreground="{StaticResource Text3}" FontSize="11" Margin="0,0,0,10"
                               Visibility="{Binding Summary, Converter={StaticResource EmptyToCollapsed}}" />

                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,3" Background="{StaticResource BgInput}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <Expander.Header>
                                        <Grid HorizontalAlignment="Stretch" Width="700">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Ellipse Grid.Column="1" Width="10" Height="10" Fill="{Binding StatusBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding FileName}" Foreground="{StaticResource Text1}"
                                                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding ActionSummary}" Foreground="{StaticResource Text2}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Details}" Margin="34,4,10,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource Text2}" FontSize="11.5"
                                                           TextWrapping="Wrap" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── PASO 4 — PLAN Y EJECUCIÓN ── -->
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PASO 4 · PLAN Y EJECUCIÓN" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="Desmarca arriba lo que no quieras preparar. La salida va a la subcarpeta _preparado, sin sobrescribir nada."
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="▶  Preparar seleccionados" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ExecuteCommand}" />
                        <Button Content="✕  Cancelar" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Command="{Binding CancelCommand}" />
                    </StackPanel>

                    <ProgressBar Height="6" Margin="0,14,0,6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Border}" BorderThickness="0" />
                    <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Text2}" FontSize="12" />
                </StackPanel>
            </Border>

            <TextBlock Text="Cualquiera puede convertir a HAP. Esto te dice, antes del bolo y de un vistazo, cuáles de los archivos del cliente van a fallar el sábado y por qué."
                       Foreground="{StaticResource Text3}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="2,4,0,20" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
