<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FormatMediaCoder.App.Views.AudioConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,8,28,28">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Convertir Audio" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,2" />
            <TextBlock Text="MP3, AAC, OGG, FLAC o WAV. Con normalización opcional (-23 LUFS)."
                       Foreground="{StaticResource FmcText2}" FontSize="13" Margin="0,0,0,18" TextWrapping="Wrap" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InputFile}" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Elegir archivo" Click="PickFile_Click" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="FORMATO" Foreground="{StaticResource FmcText3}" FontSize="11" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" DisplayMemberPath="Key" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Visibility="{Binding ShowBitrate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="BITRATE" Foreground="{StaticResource FmcText3}" FontSize="11" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="SAMPLE RATE" Foreground="{StaticResource FmcText3}" FontSize="11" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Bottom">
                            <CheckBox Content="Mono" IsChecked="{Binding Mono, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Normalizar (EBU R128 / -23 LUFS)" IsChecked="{Binding Normalize, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Convertir" Style="{StaticResource AccentButton}" Command="{Binding ConvertCommand}" />
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Foreground="{StaticResource FmcAccent}" />
                    <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource FmcText2}" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
