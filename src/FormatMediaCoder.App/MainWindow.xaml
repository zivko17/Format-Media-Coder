<Window x:Class="FormatMediaCoder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FormatMediaCoder.App.Views"
        Title="Format Media Coder" Height="780" Width="1200"
        MinHeight="600" MinWidth="960"
        Background="{StaticResource BgApp}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Navegación: dos bloques, Flujo arriba y Herramientas debajo (brief §6.2) ── -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,16,18">
                    <TextBlock Text="🎬" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Format Media" Foreground="{StaticResource Text1}" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="Coder" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <!-- Versión al pie -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,14">
                    <TextBlock Text="v2.0.0 — Eventos" Foreground="{StaticResource Text3}" FontSize="11" FontFamily="Consolas" />
                </StackPanel>

                <!-- Menú -->
                <StackPanel Margin="8,0">
                    <TextBlock Text="FLUJO" Foreground="{StaticResource Text3}" FontSize="10" FontWeight="Bold" Margin="10,4,0,4" />
                    <Button x:Name="NavPreparar" Content="🎯  Preparar Evento" Style="{StaticResource GhostButton}"
                            HorizontalContentAlignment="Left" Margin="0,2" Click="NavPreparar_Click" />

                    <TextBlock Text="HERRAMIENTAS" Foreground="{StaticResource Text3}" FontSize="10" FontWeight="Bold" Margin="10,16,0,4" />
                    <Button Content="🔄  Convertir Vídeo" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavTool_Click" />
                    <Button Content="🖼  Convertir Imágenes" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavTool_Click" />
                    <Button Content="🔍  Analizador" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavTool_Click" />
                    <Button Content="📦  Comprimir" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavTool_Click" />
                    <Button Content="✂  Edición" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavTool_Click" />
                    <Button Content="🎵  Convertir Audio" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavTool_Click" />
                    <Button Content="🎚  Extraer Audio / Frames" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="NavTool_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Contenido ── -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="0" />
    </Grid>
</Window>
