<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FormatMediaCoder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título extendida -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
                <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{StaticResource FmcText2}" />
                <TextBlock Text="Format Media Coder" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource FmcText2}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="248"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Flujo" />
                <NavigationViewItem Content="Preparar Evento" Tag="prep">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Herramientas" />
                <NavigationViewItem Content="Descargar" Tag="descargar">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Convertir Vídeo" Tag="convert">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Convertir Imágenes" Tag="imagenes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE91B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Analizador" Tag="analizador">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Comprimir" Tag="comprimir">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Edición" Tag="edicion">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Convertir Audio" Tag="audio">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Extraer Audio" Tag="extraer">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE958;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Acerca de" Tag="tool:Acerca de">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ContentControl x:Name="ContentHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>
