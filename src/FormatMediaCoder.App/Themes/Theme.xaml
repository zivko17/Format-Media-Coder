<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta sobria/técnica sobre Mica (tema oscuro fijo). El ámbar de marca se
         usa solo en el indicador de navegación y el botón principal. -->
    <SolidColorBrush x:Key="FmcCard" Color="#2A2B2D" />
    <SolidColorBrush x:Key="FmcCardHover" Color="#303133" />
    <SolidColorBrush x:Key="FmcField" Color="#212325" />
    <SolidColorBrush x:Key="FmcStroke" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="FmcStrokeStrong" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="FmcText1" Color="#ECEDED" />
    <SolidColorBrush x:Key="FmcText2" Color="#B7B9BB" />
    <SolidColorBrush x:Key="FmcText3" Color="#7E8082" />
    <SolidColorBrush x:Key="FmcAccent" Color="#D69022" />
    <SolidColorBrush x:Key="FmcGreen" Color="#5F9E6B" />
    <SolidColorBrush x:Key="FmcAmber" Color="#B8923F" />
    <SolidColorBrush x:Key="FmcRed" Color="#BD6459" />
    <SolidColorBrush x:Key="FmcGray" Color="#6C6E70" />

    <!-- El indicador de selección del NavigationView en ámbar de marca -->
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#D69022" />

    <!-- Tarjeta reutilizable -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FmcCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource FmcStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="StepNum" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FmcText3}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FmcText2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource FmcAccent}" />
        <Setter Property="Foreground" Value="#211803" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>
